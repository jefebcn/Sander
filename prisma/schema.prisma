generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PlayerRole {
  BLOCKER
  DEFENDER
}

enum TournamentType {
  KING_OF_THE_BEACH
  BRACKETS
  ROUND_ROBIN
  DOUBLE_ELIMINATION
  CHICECE
}

enum TournamentStatus {
  DRAFT
  LIVE
  COMPLETED
}

enum SessionStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum SessionFormat {
  TWO_VS_TWO
  THREE_VS_THREE
  FOUR_VS_FOUR
}

enum PaymentStatus {
  FREE
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// ─── Auth Models (NextAuth v5) ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  password     String?   // null for OAuth-only users

  // Invite tracking
  invitedByPlayerId String?
  invitedByPlayer   Player?  @relation("PlayerInvites", fields: [invitedByPlayerId], references: [id])

  accounts    Account[]
  authSessions AuthSession[]
  player      Player?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Player ───────────────────────────────────────────────────────────────────

model Player {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  gender        String?
  nationality   String?
  preferredRole PlayerRole @default(DEFENDER)
  avatarUrl     String?

  // Auth link (optional — existing players created before auth won't have this)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Tournament aggregate stats
  matchesWon     Int @default(0)
  matchesLost    Int @default(0)
  tournamentsWon Int @default(0)
  winRatePct     Int @default(0)

  // Level & XP
  level Int @default(1)
  xp    Int @default(0)

  // In-app currency
  sanderCredits Int @default(0)

  // Glicko-2 skill rating (initial values per algorithm spec)
  glickoRating     Float @default(1500)
  glickoRD         Float @default(350)
  glickoVolatility Float @default(0.06)

  // Session stats
  sessionsPlayed Int @default(0)

  // Stat distribution (must sum to 100; default = equal split)
  attPct Int @default(17)
  difPct Int @default(17)
  murPct Int @default(17)
  alzPct Int @default(17)
  ricPct Int @default(16)
  staPct Int @default(16)

  // Relations
  registrations        TournamentRegistration[]
  matchPlayers         MatchPlayer[]
  standings            TournamentStanding[]
  organizedSessions    Session[]
  sessionParticipants  SessionParticipant[]
  sessionMatchPlayers  SessionMatchPlayer[]
  tournamentsCreated   Tournament[]             @relation("TournamentCreator")
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  monthlyAwards        MonthlyAward[]
  videoSubmissions     VideoSubmission[]
  ratingHistory        RatingHistory[]
  invitedUsers         User[]             @relation("PlayerInvites")
  reactions            Reaction[]
  chatParticipants     ChatParticipant[]
  sentMessages         ChatMessage[]

  @@map("players")
}

// ─── Tournament ───────────────────────────────────────────────────────────────

model Tournament {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  date   DateTime
  type   TournamentType
  status TournamentStatus @default(DRAFT)

  kotbTotalRounds   Int?
  numCourts         Int @default(2)
  chiceceMatchCount Int @default(4)
  chicecePhase      String @default("GROUP")

  // Registration & payments
  location              String?
  description           String?
  registrationDeadline  DateTime?
  prizePool             String?   // 1° posto
  prize2nd              String?   // 2° posto
  prize3rd              String?   // 3° posto
  priceCents            Int?          // null = free
  spectatorPriceCents   Int?          // quota per spettatori/presenti
  priceCurrency         String        @default("EUR")
  isOpenForRegistration Boolean       @default(false)

  // Creator — nullable for backwards compat with existing tournaments
  createdByPlayerId String?
  createdByPlayer   Player?  @relation("TournamentCreator", fields: [createdByPlayerId], references: [id], onDelete: SetNull)

  // Cover image & display metadata
  coverUrl   String?
  skillLevel String?   // es. "Open", "B/C", "A/B/C", "Multilevel"
  gender     String?   // es. "Maschile", "Femminile", "Misto"
  maxTeams   Int?      // numero massimo squadre/coppie iscritte

  registrations TournamentRegistration[]
  matches       Match[]
  standings     TournamentStanding[]

  @@index([status])
  @@index([type, status])
  @@map("tournaments")
}

model TournamentRegistration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tournamentId         String
  playerId             String
  seedPosition         Int?
  teamName             String?
  teamLogoUrl          String?
  chicecePlusMinus     Int @default(0)
  chiceceMatchesPlayed Int @default(0)

  // Skill level (1=Dilettante, 2=Intermedio, 3=Avanzato). Nullable per retro-compatibilità.
  skillLevel Int?

  // Spectator (non-player, just attending)
  isSpectator           Boolean @default(false)

  // Payment tracking
  paymentStatus         PaymentStatus @default(FREE)
  paymentMethod         String?       // "STRIPE" | "CASH" | "FREE"
  paidAt                DateTime?
  amountPaidCents       Int?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  adminNotes            String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentId, paymentStatus])
  @@index([playerId])
  @@map("tournament_registrations")
}

model StripeWebhookEvent {
  id         String   @id                // Stripe event.id
  type       String
  receivedAt DateTime @default(now())
  payload    Json

  @@map("stripe_webhook_events")
}

model Match {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round         Int
  matchNumber   Int
  bracketSection String @default("WB")   // "WB" | "LB" | "GF"
  courtLabel    String?

  // For DOUBLE_ELIMINATION: loser drops to LB instead of being eliminated
  loserNextMatchId   String?
  loserNextMatchSlot Int?

  teamAScore Int?
  teamBScore Int?

  nextMatchId   String?
  nextMatchSlot Int?

  isCompleted Boolean @default(false)
  isBye       Boolean @default(false)

  players MatchPlayer[]

  @@index([tournamentId])
  @@map("matches")
}

model MatchPlayer {
  id      String @id @default(cuid())
  matchId String
  team    Int

  playerId String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("match_players")
}

model TournamentStanding {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  tournamentId String
  playerId     String

  points        Int @default(0)
  matchesWon    Int @default(0)
  matchesLost   Int @default(0)
  pointsFor     Int @default(0)
  pointsAgainst Int @default(0)
  rank          Int @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([playerId])
  @@map("tournament_standings")
}

// ─── Sessions ─────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizerId String
  organizer   Player @relation(fields: [organizerId], references: [id])

  title      String
  location   String
  date       DateTime
  format     SessionFormat @default(TWO_VS_TWO)
  maxPlayers Int
  courtCost  Int?
  notes      String?

  // Payment
  paymentType String  @default("FREE")  // "FREE" | "QUOTA" | "LOSER_PAYS"
  quotaAmount Int?                       // cents, per-person fixed quota
  loserPays   String?                    // e.g. "1 birra", "una cena"

  status    SessionStatus @default(OPEN)
  matchMode Boolean       @default(false)

  participants   SessionParticipant[]
  sets           SessionSet[]
  sessionMatches SessionMatch[]
  chatThread     ChatThread?

  @@index([status, date])
  @@map("sessions")
}

model SessionMatch {
  id          String   @id @default(cuid())
  sessionId   String
  round       Int
  matchNumber Int
  teamAScore  Int?
  teamBScore  Int?
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  session Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  players SessionMatchPlayer[]

  @@index([sessionId])
  @@map("session_matches")
}

model SessionMatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  team     Int    // 0 = Team A, 1 = Team B

  match  SessionMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("session_match_players")
}

model SessionSet {
  id         String  @id @default(cuid())
  sessionId  String
  setNumber  Int
  teamAScore Int
  teamBScore Int
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_sets")
}

model SessionParticipant {
  id        String  @id @default(cuid())
  sessionId String
  playerId  String?
  guestName String?
  team      Int?    // null=unassigned, 0=Team A, 1=Team B

  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([playerId])
  @@map("session_participants")
}

model RatingHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  rating     Float
  rd         Float
  source     String  // "tournament" | "session"
  sourceId   String  // tournament or session id

  @@index([playerId, createdAt])
  @@index([createdAt])
  @@map("rating_history")
}

model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId String
  endpoint String @unique
  p256dh   String
  auth     String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  playerId  String
  title     String
  body      String
  url       String?
  readAt    DateTime?

  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@map("notifications")
}

// ── Chat ──────────────────────────────────────────────────────────────
enum ChatKind {
  DM       // 1:1 direct message between two players
  SESSION  // group chat attached to a session (one per session)
  GROUP    // ad-hoc group chat (not tied to a session)
}

model ChatThread {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  kind          ChatKind  @default(DM)

  name          String?   // optional title for GROUP threads
  createdById   String?   // who created a GROUP (can delete it)

  // DM dedup: sorted "playerA:playerB" so a pair always has one thread. Null for SESSION.
  dmKey         String?   @unique

  // SESSION threads link to their session (one per session). Null for DM.
  sessionId     String?   @unique
  session       Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime? // for inbox sorting

  participants  ChatParticipant[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
  @@map("chat_threads")
}

model ChatParticipant {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())

  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?  // for unread badges

  @@unique([threadId, playerId])
  @@index([playerId])
  @@map("chat_participants")
}

model ChatMessage {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())

  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Player     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model VideoSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  blobUrl   String
  status    String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  note      String?  // admin rejection note

  reviewedAt DateTime?

  @@map("video_submissions")
}

// ─── Monthly Podium Awards ────────────────────────────────────────────────────

model MonthlyAward {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position  Int      // 1, 2, o 3
  month     Int      // 1–12
  year      Int      // es. 2026

  @@unique([playerId, month, year])
  @@unique([position, month, year])
  @@map("monthly_awards")
}

// ─── ContentPost (auto-generated social content queue) ──────────────────────

model ContentPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  kind        String // "weekly" | "community" | "tournament"
  title       String
  caption     String
  hashtags    String
  imagePath   String // route that renders the 1080x1920 image
  status      String    @default("READY") // READY | PUBLISHED | SKIPPED
  publishedAt DateTime?

  @@index([status, createdAt])
  @@map("content_posts")
}

// ─── Reaction (kudos on feed activity) ──────────────────────────────────────

model Reaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId   String
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  targetType String // "match" | "session" | "tournament"
  targetId   String
  emoji      String @default("🔥")

  @@unique([playerId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

// ─── Season (ranked seasons + divisions) ────────────────────────────────────

model Season {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name     String   // "Estate 2026", "Luglio"
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  @@map("seasons")
}
