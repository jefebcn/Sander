# Firma per il Play Store.
# 1. Copia questo file nella stessa cartella e chiamalo keystore.properties
#    (android/keystore.properties): e' escluso da git, non va mai su GitHub.
# 2. Inserisci i tuoi valori qui sotto, solo sul computer che fa la build.
#
# storeFile: percorso completo della chiave di caricamento (.jks o .keystore).
#   Su Windows usa / al posto di \  ->  C:/Users/Nome/Documents/chiavi/sander-upload.jks
storeFile=C:/percorso/della/chiave/sander-upload.jks
storePassword=PASSWORD_DEL_KEYSTORE
keyAlias=ALIAS_DELLA_CHIAVE
keyPassword=PASSWORD_DELLA_CHIAVE
