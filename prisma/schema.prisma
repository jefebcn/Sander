generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Relations come back in the same query (LATERAL JOIN) instead of one query
  // per relation: far fewer round trips to the database on every page.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PlayerRole {
  BLOCKER
  DEFENDER
}

enum TournamentType {
  KING_OF_THE_BEACH
  BRACKETS
  ROUND_ROBIN
  DOUBLE_ELIMINATION
  CHICECE
}

enum TournamentStatus {
  DRAFT
  LIVE
  COMPLETED
}

enum SessionStatus {
  OPEN
  FULL
  COMPLETED
  CANCELLED
}

enum SessionFormat {
  TWO_VS_TWO
  THREE_VS_THREE
  FOUR_VS_FOUR
}

enum PaymentStatus {
  FREE
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// ─── Auth Models (NextAuth v5) ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  password     String?   // null for OAuth-only users

  // Invite tracking
  invitedByPlayerId String?
  invitedByPlayer   Player?  @relation("PlayerInvites", fields: [invitedByPlayerId], references: [id])
  // Set once both referral rewards are paid (after the invitee's first real match)
  inviteRewardedAt  DateTime?

  accounts    Account[]
  authSessions AuthSession[]
  player      Player?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Player ───────────────────────────────────────────────────────────────────

model Player {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  gender        String?
  nationality   String?
  preferredRole PlayerRole @default(DEFENDER)
  avatarUrl     String?

  // Auth link (optional — existing players created before auth won't have this)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Tournament aggregate stats
  matchesWon     Int @default(0)
  matchesLost    Int @default(0)
  tournamentsWon Int @default(0)
  winRatePct     Int @default(0)

  // Level & XP
  level Int @default(1)
  xp    Int @default(0)

  // In-app currency
  sanderCredits Int @default(0)

  /// Comune where the player usually plays (one of lib/cities CITY_NAMES).
  /// Personalises the home: matches, leaderboard and "your town" card.
  homeCity   String?
  /// Level declared at sign-up (lib/startLevel), used to seed the rating.
  startLevel String?
  /// Turned off "manca un giocatore" pushes from the profile.
  nudgesOptOut Boolean @default(false)

  // Glicko-2 skill rating (initial values per algorithm spec)
  glickoRating     Float @default(1500)
  glickoRD         Float @default(350)
  glickoVolatility Float @default(0.06)

  // Session stats
  sessionsPlayed Int @default(0)

  // Stat distribution (must sum to 100; default = equal split)
  attPct Int @default(17)
  difPct Int @default(17)
  murPct Int @default(17)
  alzPct Int @default(17)
  ricPct Int @default(16)
  staPct Int @default(16)

  // Relations
  registrations        TournamentRegistration[]
  matchPlayers         MatchPlayer[]
  standings            TournamentStanding[]
  organizedSessions    Session[]
  sessionParticipants  SessionParticipant[]
  sessionMatchPlayers  SessionMatchPlayer[]
  tournamentsCreated   Tournament[]             @relation("TournamentCreator")
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  monthlyAwards        MonthlyAward[]
  videoSubmissions     VideoSubmission[]
  ratingHistory        RatingHistory[]
  invitedUsers         User[]             @relation("PlayerInvites")
  availability         PlayerAvailability[]
  sessionWaitlist      SessionWaitlist[]
  sessionNudges        SessionNudge[]
  reactions            Reaction[]
  chatParticipants     ChatParticipant[]
  sentMessages         ChatMessage[]
  creditTopUps         CreditTopUp[]

  // Scopri: profile for finding teammates, swipes, matches, duos.
  discoverPhotos       PlayerPhoto[]
  discoverPrompts      PlayerPrompt[]
  discoverProfile      DiscoverProfile?
  selfieChecks         SelfieCheck[]
  swipesSent           PlayerSwipe[]      @relation("SwipesSent")
  swipesReceived       PlayerSwipe[]      @relation("SwipesReceived")
  matchesAsA           PlayerMatch[]      @relation("PlayerMatchA")
  matchesAsB           PlayerMatch[]      @relation("PlayerMatchB")
  dailyPicks           DailyPick[]        @relation("DailyPickOwner")
  pickedIn             DailyPick[]        @relation("DailyPickTarget")
  blocksMade           PlayerBlock[]      @relation("BlocksMade")
  blocksReceived       PlayerBlock[]      @relation("BlocksReceived")
  creditSpends         CreditSpend[]
  duosFormed           Duo[]              @relation("DuoA")
  duosJoined           Duo[]              @relation("DuoB")
  attendanceEvents     AttendanceEvent[]
  playAgainGiven       PlayAgainVote[]    @relation("PlayAgainVoter")
  playAgainReceived    PlayAgainVote[]    @relation("PlayAgainTarget")

  @@map("players")
}

// ─── Tournament ───────────────────────────────────────────────────────────────

model Tournament {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  date   DateTime
  type   TournamentType
  status TournamentStatus @default(DRAFT)

  kotbTotalRounds   Int?
  numCourts         Int @default(2)
  chiceceMatchCount Int @default(4)
  chicecePhase      String @default("GROUP")

  // Registration & payments
  location              String?
  description           String?
  registrationDeadline  DateTime?
  prizePool             String?   // 1° posto
  prize2nd              String?   // 2° posto
  prize3rd              String?   // 3° posto
  priceCents            Int?          // null = free
  spectatorPriceCents   Int?          // quota per spettatori/presenti
  priceCurrency         String        @default("EUR")
  isOpenForRegistration Boolean       @default(false)

  // Creator — nullable for backwards compat with existing tournaments
  createdByPlayerId String?
  createdByPlayer   Player?  @relation("TournamentCreator", fields: [createdByPlayerId], references: [id], onDelete: SetNull)

  // Cover image & display metadata
  coverUrl   String?
  skillLevel String?   // es. "Open", "B/C", "A/B/C", "Multilevel"
  gender     String?   // es. "Maschile", "Femminile", "Misto"
  maxTeams   Int?      // numero massimo squadre/coppie iscritte

  registrations TournamentRegistration[]
  matches       Match[]
  standings     TournamentStanding[]

  @@index([status])
  @@index([type, status])
  @@map("tournaments")
}

model TournamentRegistration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  tournamentId         String
  playerId             String
  seedPosition         Int?
  teamName             String?
  teamLogoUrl          String?
  chicecePlusMinus     Int @default(0)
  chiceceMatchesPlayed Int @default(0)

  // Skill level (1=Dilettante, 2=Intermedio, 3=Avanzato). Nullable per retro-compatibilità.
  skillLevel Int?

  // Spectator (non-player, just attending)
  isSpectator           Boolean @default(false)

  // Payment tracking
  paymentStatus         PaymentStatus @default(FREE)
  paymentMethod         String?       // "STRIPE" | "CASH" | "FREE"
  paidAt                DateTime?
  amountPaidCents       Int?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  adminNotes            String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentId, paymentStatus])
  @@index([playerId])
  @@map("tournament_registrations")
}

model StripeWebhookEvent {
  id         String   @id                // Stripe event.id
  type       String
  receivedAt DateTime @default(now())
  payload    Json

  @@map("stripe_webhook_events")
}

model Match {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round         Int
  matchNumber   Int
  bracketSection String @default("WB")   // "WB" | "LB" | "GF"
  courtLabel    String?

  // For DOUBLE_ELIMINATION: loser drops to LB instead of being eliminated
  loserNextMatchId   String?
  loserNextMatchSlot Int?

  teamAScore Int?
  teamBScore Int?

  nextMatchId   String?
  nextMatchSlot Int?

  isCompleted Boolean @default(false)
  isBye       Boolean @default(false)

  players MatchPlayer[]

  @@index([tournamentId])
  // Podio mensile e raccomandazioni filtrano su questi due, non su tournamentId.
  @@index([isCompleted, updatedAt])
  @@map("matches")
}

model MatchPlayer {
  id      String @id @default(cuid())
  matchId String
  team    Int

  playerId String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("match_players")
}

model TournamentStanding {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  tournamentId String
  playerId     String

  points        Int @default(0)
  matchesWon    Int @default(0)
  matchesLost   Int @default(0)
  pointsFor     Int @default(0)
  pointsAgainst Int @default(0)
  rank          Int @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([playerId])
  @@map("tournament_standings")
}

// ─── Sessions ─────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizerId String
  organizer   Player @relation(fields: [organizerId], references: [id])

  title      String
  location   String
  // Comune scelto esplicitamente dall'organizzatore. Le classifiche di città
  // ricavavano il comune dal testo di location, che spesso non lo nomina: qui
  // il dato è certo. Resta nullable per le partite create prima di questo campo.
  city       String?
  date       DateTime
  format     SessionFormat @default(TWO_VS_TWO)
  maxPlayers Int
  courtCost  Int?
  notes      String?

  // Payment
  paymentType String  @default("FREE")  // "FREE" | "QUOTA" | "LOSER_PAYS"
  quotaAmount Int?                       // cents, per-person fixed quota
  loserPays   String?                    // e.g. "1 birra", "una cena"

  status    SessionStatus @default(OPEN)
  matchMode Boolean       @default(false)

  liveScore Json?         // stato del tabellone dal vivo in corso (auto-save + resume + sync)

  participants   SessionParticipant[]
  sets           SessionSet[]
  sessionMatches SessionMatch[]
  waitlist       SessionWaitlist[]
  nudges         SessionNudge[]
  chatThread     ChatThread?

  @@index([status, date])
  @@index([status, updatedAt])
  @@map("sessions")
}

model SessionMatch {
  id          String   @id @default(cuid())
  sessionId   String
  round       Int
  matchNumber Int
  teamAScore  Int?
  teamBScore  Int?
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  session Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  players SessionMatchPlayer[]

  @@index([sessionId])
  @@index([isCompleted, updatedAt])
  @@map("session_matches")
}

model SessionMatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  team     Int    // 0 = Team A, 1 = Team B

  match  SessionMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@map("session_match_players")
}

model SessionSet {
  id         String  @id @default(cuid())
  sessionId  String
  setNumber  Int
  teamAScore Int
  teamBScore Int
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_sets")
}

model SessionParticipant {
  id        String  @id @default(cuid())
  sessionId String
  playerId  String?
  guestName String?
  team      Int?    // null=unassigned, 0=Team A, 1=Team B

  // SanderCredits this participant actually paid to join. Refunded verbatim on
  // leave, so someone the organiser added for free can never farm credits.
  paidCredits Int @default(0)

  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([playerId])
  @@map("session_participants")
}

model RatingHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  rating     Float
  rd         Float
  source     String  // "tournament" | "session"
  sourceId   String  // tournament or session id

  @@index([playerId, createdAt])
  @@index([createdAt])
  @@map("rating_history")
}

model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId String
  endpoint String @unique
  p256dh   String
  auth     String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  playerId  String
  title     String
  body      String
  url       String?
  readAt    DateTime?

  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@map("notifications")
}

// ── Chat ──────────────────────────────────────────────────────────────
enum ChatKind {
  DM       // 1:1 direct message between two players
  SESSION  // group chat attached to a session (one per session)
  GROUP    // ad-hoc group chat (not tied to a session)
}

model ChatThread {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  kind          ChatKind  @default(DM)

  name          String?   // optional title for GROUP threads
  createdById   String?   // who created a GROUP (can delete it)

  // DM dedup: sorted "playerA:playerB" so a pair always has one thread. Null for SESSION.
  dmKey         String?   @unique

  // SESSION threads link to their session (one per session). Null for DM.
  sessionId     String?   @unique
  session       Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime? // for inbox sorting

  participants  ChatParticipant[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
  @@map("chat_threads")
}

model ChatParticipant {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())

  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?  // for unread badges

  @@unique([threadId, playerId])
  @@index([playerId])
  @@map("chat_participants")
}

model ChatMessage {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())

  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Player     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String
  /// A "proponi una partita" card instead of plain text (the body stays as fallback).
  proposalId String?
  proposal   GameProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([proposalId])
  @@map("chat_messages")
}

model VideoSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  blobUrl   String
  status    String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  note      String?  // admin rejection note

  reviewedAt DateTime?

  @@map("video_submissions")
}

// ─── Monthly Podium Awards ────────────────────────────────────────────────────

model MonthlyAward {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position  Int      // 1, 2, o 3
  month     Int      // 1–12
  year      Int      // es. 2026

  @@unique([playerId, month, year])
  @@unique([position, month, year])
  @@map("monthly_awards")
}

// ─── ContentPost (auto-generated social content queue) ──────────────────────

model ContentPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  kind        String // "weekly" | "community" | "tournament"
  title       String
  caption     String
  hashtags    String
  imagePath   String // route that renders the 1080x1920 image
  status      String    @default("READY") // READY | PUBLISHED | SKIPPED
  publishedAt DateTime?

  @@index([status, createdAt])
  @@map("content_posts")
}

// ─── Reaction (kudos on feed activity) ──────────────────────────────────────

model Reaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId   String
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  targetType String // "match" | "session" | "tournament"
  targetId   String
  emoji      String @default("🔥")

  @@unique([playerId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

// ─── Season (ranked seasons + divisions) ────────────────────────────────────

model Season {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name     String   // "Estate 2026", "Luglio"
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  @@map("seasons")
}

/// When a player is usually free to play. Powers the "Sono libero" board:
/// until now a match only existed if somebody created one, so a newcomer with
/// no contacts had nothing to join and never came back.
model PlayerAvailability {
  id       String            @id @default(cuid())
  playerId String
  weekday  Int // 0=domenica … 6=sabato, come Date.getDay()
  slot     AvailabilitySlot

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, weekday, slot])
  @@index([weekday, slot])
  @@map("player_availability")
}

enum AvailabilitySlot {
  MORNING
  AFTERNOON
  EVENING
}

/// "Manca un giocatore" pushes already sent. Unique per session+player so
/// nobody is pinged twice about the same match; also the daily cooldown.
model SessionNudge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String
  playerId  String

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([playerId, createdAt])
  @@map("session_nudges")
}

/// Queue on a full session. Someone arriving from a shared link on a full match
/// had no hook at all and simply left; now they queue and get a push the moment
/// a seat frees up.
model SessionWaitlist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String
  playerId  String

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([sessionId, createdAt])
  @@map("session_waitlist")
}

/// How the euros behind a SanderCredits top-up were received.
enum TopUpMethod {
  PAYPAL
  BONIFICO
  CONTANTI
  OMAGGIO // credits given for free — no money received
  STRIPE  // bought in-app through Stripe Checkout, credited by the webhook
}

/// Ledger of SanderCredits top-ups.
/// Credits are paid outside the app (PayPal, bank transfer, cash) and added by
/// an admin; without this row the app only knew "+N SC" and never the euros
/// behind it, so revenue and average top-up were impossible to measure.
model CreditTopUp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  credits     Int
  amountCents Int // 0 when method = OMAGGIO
  method      TopUpMethod
  note        String?
  createdByEmail String?
  /// Set for STRIPE top-ups; unique so a replayed webhook can't credit twice.
  stripeSessionId String? @unique
  /// Set when the card payment is refunded on Stripe and the credits taken back.
  refundedAt      DateTime?

  @@index([createdAt])
  @@index([playerId])
  @@map("credit_topups")
}

// ─── Scopri: trova compagni di gioco ────────────────────────────────────────
// One player at a time, a like on a specific photo or prompt (optionally with
// a comment), a match when it's mutual, then the chat and a match on the sand.
// Duos (2v2) do the same, pair against pair, and end up in a group chat.

enum SwipeTarget {
  PROFILE
  PHOTO
  PROMPT
}

enum LikeStatus {
  PENDING
  MATCHED
  DECLINED
}

enum DuoStatus {
  PENDING
  ACTIVE
  ENDED
}

/// Up to 6 photos shown on the Scopri card, in order.
model PlayerPhoto {
  id        String   @id @default(cuid())
  playerId  String
  url       String
  position  Int
  createdAt DateTime @default(now())
  /// Removed by an admin: kept for the record, never shown.
  hiddenAt  DateTime?
  /// Reported by someone (shown first in the admin review).
  reportedAt DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, position])
  @@index([createdAt])
  @@map("player_photos")
}

/// Three answers to beach volley prompts (keys in lib/scopri/prompts).
model PlayerPrompt {
  id        String   @id @default(cuid())
  playerId  String
  promptKey String
  answer    String
  position  Int
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, position])
  @@map("player_prompts")
}

/// Scopri settings: what you look for, your dealbreakers, extras bought with SC.
model DiscoverProfile {
  playerId  String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Side of the court: SINISTRA | DESTRA | ENTRAMBI.
  side       String?
  /// Any of COMPAGNO | PARTITE | ALLENAMENTO | TORNEI | MISTO.
  lookingFor String[] @default([])
  /// Hidden from Scopri while true (matches and chats stay).
  paused     Boolean  @default(false)

  // Dealbreakers, applied both ways: two players see each other only if each
  // one meets the other's.
  prefCities String[]    @default([])
  prefGender String?
  prefRole   PlayerRole?
  /// Largest rating gap accepted.
  maxGap     Int         @default(300)

  /// Likes and Aces bought with SC, used once the free ones run out.
  bonusLikes         Int       @default(0)
  bonusAces          Int       @default(0)
  /// "Ti vogliono" shows everyone at once until this instant (bought with SC).
  likesUnlockedUntil DateTime?

  /// "Libero oggi": the Rome day (YYYY-MM-DD) and slot (MORNING | AFTERNOON |
  /// EVENING | ANY). Stale once the day is over, no cleanup needed.
  freeDay         String?
  freeSlot        String?
  /// Day matches were last told you're free, so they hear it once a day.
  freeNotifiedDay String?
  /// When the profile first became complete (for "new on Scopri" digests).
  readyAt         DateTime?
  /// Last Scopri reminder push, so nobody gets more than one a few days.
  nudgedAt        DateTime?

  /// Suspended by an admin: out of the pool, can't like. Matches and chats stay.
  suspendedAt     DateTime?
  suspendedReason String?

  /// SANDER+ until this instant (Stripe subscription, renewed by the webhook).
  plusUntil            DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// SANDER+ filters on the deck.
  onlyVerified         Boolean   @default(false)
  onlyFreeToday        Boolean   @default(false)

  /// "Aperto a conoscersi": besides playing, open to something more. Shown only
  /// to people who are open too and whose "mostrami" fits (lib/scopri/rules).
  openToMeet           Boolean   @default(false)
  /// UOMINI | DONNE | TUTTI: who they'd like to meet. Only with openToMeet.
  showMe               String?
  /// Deck limited to people who are open to meeting and fit both ways.
  meetOnly             Boolean   @default(false)
  /// Explicit consent to process this preference (it can reveal orientation).
  meetConsentAt        DateTime?
  /// Selfie with the requested gesture approved by an admin (SelfieCheck).
  photoVerifiedAt      DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([stripeSubscriptionId])
  @@map("discover_profiles")
}

/// One row per direction of a pair: a like (on a photo, a prompt or the whole
/// profile) or a skip. Skips expire, so a face can come back later.
model PlayerSwipe {
  id          String      @id @default(cuid())
  fromId      String
  toId        String
  liked       Boolean
  target      SwipeTarget @default(PROFILE)
  targetId    String?
  /// What was liked, frozen at the time (prompt text or photo url).
  targetLabel String?
  comment     String?
  /// Ace: the weekly super like, shown first in "Ti vogliono".
  isAce       Boolean     @default(false)
  /// A like sent from "Ti vogliono" to answer one: free, it makes the match.
  reply       Boolean     @default(false)
  status      LikeStatus  @default(PENDING)
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  from Player @relation("SwipesSent", fields: [fromId], references: [id], onDelete: Cascade)
  to   Player @relation("SwipesReceived", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, liked, status])
  @@index([fromId, createdAt])
  @@map("player_swipes")
}

/// A mutual like. aId < bId so a pair has one row.
model PlayerMatch {
  id        String    @id @default(cuid())
  aId       String
  bId       String
  threadId  String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  /// "Avete giocato insieme?" answered by each side (null = not asked yet).
  aPlayed   Boolean?
  bPlayed   Boolean?
  /// Last "tocca a te" reminder to each side.
  aNudgedAt DateTime?
  bNudgedAt DateTime?

  a Player @relation("PlayerMatchA", fields: [aId], references: [id], onDelete: Cascade)
  b Player @relation("PlayerMatchB", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
  @@index([bId])
  @@map("player_matches")
}

/// "Il più compatibile di oggi": one stable pairing of the pool per Rome day.
model DailyPick {
  id        String   @id @default(cuid())
  playerId  String
  pickId    String
  /// Rome calendar day, YYYY-MM-DD.
  day       String
  score     Int
  reasons   String[] @default([])
  createdAt DateTime @default(now())
  /// Push "il più compatibile di oggi" sent.
  notifiedAt DateTime?

  player Player @relation("DailyPickOwner", fields: [playerId], references: [id], onDelete: Cascade)
  pick   Player @relation("DailyPickTarget", fields: [pickId], references: [id], onDelete: Cascade)

  @@unique([playerId, day])
  @@map("daily_picks")
}

/// Block, optionally with a report. Either way the two never see each other again.
model PlayerBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reported  Boolean  @default(false)
  reason    String?
  note      String?
  createdAt DateTime @default(now())
  /// An admin looked at the report and closed it.
  reviewedAt DateTime?

  blocker Player @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Player @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("player_blocks")
}

/// Every SC spent on Scopri extras, for support and refunds.
model CreditSpend {
  id        String   @id @default(cuid())
  playerId  String
  kind      String
  credits   Int
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@map("credit_spends")
}

/// A pair that plays 2v2 together and looks for another pair.
model Duo {
  id         String    @id @default(cuid())
  aId        String
  bId        String
  status     DuoStatus @default(PENDING)
  name       String?
  motto      String?
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  endedAt    DateTime?
  /// Pair rating (Elo), moved by 2v2s against other pairs.
  rating     Float     @default(1500)
  wins       Int       @default(0)
  losses     Int       @default(0)

  a Player @relation("DuoA", fields: [aId], references: [id], onDelete: Cascade)
  b Player @relation("DuoB", fields: [bId], references: [id], onDelete: Cascade)

  swipesSent     DuoSwipe[] @relation("DuoSwipesSent")
  swipesReceived DuoSwipe[] @relation("DuoSwipesReceived")
  matchesAsA     DuoMatch[] @relation("DuoMatchA")
  matchesAsB     DuoMatch[] @relation("DuoMatchB")

  @@index([aId, status])
  @@index([bId, status])
  @@map("duos")
}

model DuoSwipe {
  id        String     @id @default(cuid())
  fromDuoId String
  toDuoId   String
  /// Which member of the pair sent it.
  byId      String
  liked     Boolean
  comment   String?
  reply     Boolean    @default(false)
  status    LikeStatus @default(PENDING)
  createdAt DateTime   @default(now())
  /// The challenged pair was reminded once.
  remindedAt DateTime?

  fromDuo Duo @relation("DuoSwipesSent", fields: [fromDuoId], references: [id], onDelete: Cascade)
  toDuo   Duo @relation("DuoSwipesReceived", fields: [toDuoId], references: [id], onDelete: Cascade)

  @@unique([fromDuoId, toDuoId])
  @@index([toDuoId, liked, status])
  @@map("duo_swipes")
}

/// Two pairs that liked each other: a group chat of four and, soon, a 2v2.
model DuoMatch {
  id        String   @id @default(cuid())
  aDuoId    String
  bDuoId    String
  threadId  String?
  sessionId String?
  createdAt DateTime @default(now())
  /// The 2v2 result already moved the pair ratings.
  ratedAt   DateTime?

  aDuo Duo @relation("DuoMatchA", fields: [aDuoId], references: [id], onDelete: Cascade)
  bDuo Duo @relation("DuoMatchB", fields: [bDuoId], references: [id], onDelete: Cascade)

  @@unique([aDuoId, bDuoId])
  @@index([bDuoId])
  @@map("duo_matches")
}

// ─── Affidabilità ───────────────────────────────────────────────────────────

enum AttendanceKind {
  LATE_CANCEL
  NO_SHOW
}

/// Something that lowers a player's attendance: for now, leaving a match in
/// the last hours before it starts. Presences come from Player.sessionsPlayed.
model AttendanceEvent {
  id        String         @id @default(cuid())
  playerId  String
  sessionId String?
  kind      AttendanceKind
  createdAt DateTime       @default(now())
  /// "Ero presente": contested by the player; it stops counting until an
  /// admin confirms it (resolvedAt). A cancelled absence is deleted.
  disputedAt  DateTime?
  disputeNote String?
  resolvedAt  DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, kind])
  @@map("attendance_events")
}

/// "Rigiocheresti con lui/lei?" after a match played together. A "no" also
/// keeps the two apart on Scopri; many "no" from different people reach admins.
model PlayAgainVote {
  id        String   @id @default(cuid())
  voterId   String
  targetId  String
  sessionId String
  again     Boolean
  createdAt DateTime @default(now())

  voter  Player @relation("PlayAgainVoter", fields: [voterId], references: [id], onDelete: Cascade)
  target Player @relation("PlayAgainTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([voterId, targetId, sessionId])
  @@index([targetId, again])
  @@map("play_again_votes")
}

/// Errors seen by players or by the server, grouped: the same error on the
/// same page is one row with a counter (see lib/errorLog.ts, /admin/sistema).
model AppError {
  id          String   @id @default(cuid())
  /// sha1 of source + message + where: one row per distinct error.
  fingerprint String   @unique
  /// "client" (a player's browser) or "server".
  source      String
  message     String
  /// Page or route where it happened.
  path        String?
  stack       String?
  /// Next.js error digest, to find the matching server log line.
  digest      String?
  userAgent   String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
  @@map("app_errors")
}

/// Selfie taken with a random gesture, compared by an admin with the Scopri
/// photos. The image is deleted once decided; only the outcome is kept.
model SelfieCheck {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Blob url while PENDING, null after the decision.
  imageUrl   String?
  /// Key of the requested gesture (lib/scopri/selfie.ts).
  gesture    String
  /// PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")
  reviewedAt DateTime?
  note       String?

  @@index([status, createdAt])
  @@index([playerId, createdAt])
  @@map("selfie_checks")
}

/// "Proponi una partita" in a private chat: when and where. Accepting a GAME
/// creates a 2v2 with the two of them as a pair and two seats open; accepting a
/// TRAINING just confirms it between the two.
model GameProposal {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  threadId    String
  fromId      String
  toId        String
  date        DateTime
  location    String
  city        String?
  /// PENDING | ACCEPTED | DECLINED | CANCELLED
  status      String    @default("PENDING")
  /// GAME (a 2v2 with the two of you as a pair) | TRAINING (just the two of you)
  kind        String    @default("GAME")
  /// For TRAINING: what you work on (PALLEGGIO | SERVIZIO | RICEZIONE | TUTTO).
  focus       String?
  respondedAt DateTime?
  sessionId   String?
  messages    ChatMessage[]

  @@index([threadId])
  @@index([toId, status])
  @@map("game_proposals")
}
